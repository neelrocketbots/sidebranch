{
  "manifest_version": 3,
  "name": "sidebranch",
  "version": "0.1.0",
  "description": "Review PRs from inside your running app: switch branches from an in-page widget backed by a local sidebranch daemon.",
  "homepage_url": "https://sidebranch.dev/",
  "minimum_chrome_version": "116",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": ["http://localhost/*", "http://127.0.0.1/*"],
      "js": ["widget-core.js", "boot-extension.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["geist-pixel.woff2"],
      "matches": ["http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "sidebranch"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
